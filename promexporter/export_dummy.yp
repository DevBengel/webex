# exporter.py
import time
import random
from prometheus_client import start_http_server, Gauge

PORT = 8000
POLL_INTERVAL = 15

# Beispielgeräte – später durch Webex Devices API ersetzen
DEVICES = [
    {
        "device_id": "dev-001",
        "device": "RoomKit Mini Schulung 1",
        "workspace": "Raum 1"
    },
    {
        "device_id": "dev-002",
        "device": "RoomKit Mini Schulung 2",
        "workspace": "Raum 2"
    },
    {
        "device_id": "dev-003",
        "device": "Boardroom",
        "workspace": "Konferenzraum"
    }
]

LABELS = ["device", "device_id", "workspace"]

roomos_device_online = Gauge(
    "roomos_device_online",
    "RoomOS device online status, 1=online, 0=offline",
    LABELS
)

roomos_health_score = Gauge(
    "roomos_health_score",
    "Calculated RoomOS health score",
    LABELS
)

roomos_call_connected = Gauge(
    "roomos_call_connected",
    "RoomOS call status, 1=in call, 0=not in call",
    LABELS
)

roomos_microphones_muted = Gauge(
    "roomos_microphones_muted",
    "RoomOS microphone mute status, 1=muted, 0=unmuted",
    LABELS
)

roomos_standby_state = Gauge(
    "roomos_standby_state",
    "RoomOS standby state, 1=standby/halfwake, 0=active",
    LABELS
)

roomos_ethernet_speed_mbps = Gauge(
    "roomos_ethernet_speed_mbps",
    "RoomOS ethernet speed in Mbps",
    LABELS + ["interface"]
)

roomos_packet_loss = Gauge(
    "roomos_packet_loss",
    "RoomOS packet loss in percent",
    LABELS + ["direction", "media"]
)

roomos_jitter_ms = Gauge(
    "roomos_jitter_ms",
    "RoomOS jitter in milliseconds",
    LABELS + ["direction", "media"]
)

roomos_temperature_alarm = Gauge(
    "roomos_temperature_alarm",
    "RoomOS temperature alarm, 1=alarm, 0=normal",
    LABELS
)


def collect_device_metrics(device):
    labels = {
        "device": device["device"],
        "device_id": device["device_id"],
        "workspace": device["workspace"]
    }

    # Demo-Werte
    # Später hier echte Webex/xAPI-Abfragen einsetzen
    online = random.choice([1, 1, 1, 1, 0])
    muted = random.choice([0, 0, 0, 1])
    in_call = random.choice([0, 0, 1])
    standby = random.choice([0, 0, 1])
    packet_loss = round(random.uniform(0, 3), 2) if in_call else 0
    jitter = round(random.uniform(2, 40), 1) if in_call else 0
    temperature_alarm = random.choice([0, 0, 0, 0, 1])

    health = 100
    if not online:
        health -= 60
    if muted:
        health -= 5
    if packet_loss > 2:
        health -= 15
    if jitter > 30:
        health -= 10
    if temperature_alarm:
        health -= 30

    health = max(0, health)

    roomos_device_online.labels(**labels).set(online)
    roomos_health_score.labels(**labels).set(health)
    roomos_call_connected.labels(**labels).set(in_call)
    roomos_microphones_muted.labels(**labels).set(muted)
    roomos_standby_state.labels(**labels).set(standby)
    roomos_temperature_alarm.labels(**labels).set(temperature_alarm)

    roomos_ethernet_speed_mbps.labels(
        **labels,
        interface="1"
    ).set(1000)

    roomos_packet_loss.labels(
        **labels,
        direction="incoming",
        media="audio"
    ).set(packet_loss)

    roomos_jitter_ms.labels(
        **labels,
        direction="incoming",
        media="audio"
    ).set(jitter)


def main():
    print(f"Starting RoomOS exporter on http://0.0.0.0:{PORT}/metrics")
    start_http_server(PORT, addr="0.0.0.0")

    while True:
        for device in DEVICES:
            collect_device_metrics(device)

        time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    main()
